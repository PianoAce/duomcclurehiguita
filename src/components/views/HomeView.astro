---
import SectionTitle from "../SectionTitle.astro";
import ConcertRow from "../ConcertRow.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { ui, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].home;

const conciertos = await getCollection("conciertos");
const today = new Date();
today.setHours(0, 0, 0, 0);

const proximos = conciertos
  .filter((c: CollectionEntry<"conciertos">) => c.data.fecha.valueOf() >= today.valueOf())
  .sort(
    (a: CollectionEntry<"conciertos">, b: CollectionEntry<"conciertos">) =>
      a.data.fecha.valueOf() - b.data.fecha.valueOf(),
  )
  .slice(0, 3);
---

<section class="hero-photo relative flex h-screen flex-col justify-end bg-earth-green bg-cover">
  <div class="absolute inset-0 bg-linear-to-b from-earth-green/00 via-transparent to-earth-green/55"></div>
  <div class="relative flex w-full justify-end px-6 py-16 text-old-lace md:px-10 md:py-20">
    <div class="max-w-md">
      <h1 class="font-display text-5xl leading-[1.05] md:text-6xl text-shadow-md">McClure<br />&amp; Higuita</h1>
      <p class="mt-6 text-base text-old-lace/90 md:text-lg text-shadow-md">
        {t.heroDescription}
      </p>
    </div>
  </div>
</section>

<section class="px-6 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <SectionTitle>{t.nextConcerts}</SectionTitle>
    {
      proximos.length > 0 ? (
        <>
          {proximos.map((c) => (
            <ConcertRow concierto={c} lang={lang} />
          ))}
          <div class="border-t border-coyote/20 pt-6 text-right">
            <a href={lang === "en" ? "/en/conciertos" : "/conciertos"} class="text-sm text-coyote hover:text-kobicha">
              {t.viewFullSchedule}
            </a>
          </div>
        </>
      ) : (
        <p class="border-t border-coyote/25 pt-8 text-coyote">{t.noConcerts}</p>
      )
    }
  </div>
</section>

<style>
  .hero-photo {
    background-image: url("/images/hero-duo.jpg");
    background-position: center;
  }

  @media (max-width: 767px) {
    .hero-photo {
      background-image: url("/images/hero-mobile.jpg");
      background-position: left center;
    }
  }
</style>
