---
interface SocialLink {
  label: string;
  href: string;
  icon: "facebook" | "instagram";
}

const links: SocialLink[] = [
  { label: "Facebook", href: "https://www.facebook.com/share/1DAoEFZdLC/?mibextid=wwXIfr", icon: "facebook" },
  { label: "Instagram", href: "https://www.instagram.com/duomacyjuanc?stkn=cWU2bXhpeW41dmQw", icon: "instagram" },
];

interface Props {
  tone?: "light" | "dark";
  class?: string;
}
const { tone = "light", class: className = "" } = Astro.props;
---

<ul class:list={["flex items-center gap-3", className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noreferrer"
          aria-label={link.label}
          class:list={[
            "inline-flex h-9 w-9 items-center justify-center rounded-full border transition-colors",
            tone === "dark"
              ? "border-old-lace/30 text-old-lace hover:border-goldenrod hover:text-goldenrod"
              : "border-coyote/40 text-coyote hover:border-kobicha hover:text-kobicha",
          ]}
        >
          {link.icon === "facebook" ? (
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="9" />
              <path
                d="M14 8.5h-1.3c-.9 0-1.4.5-1.4 1.4V12h2.5l-.35 2.2h-2.15V21"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>
