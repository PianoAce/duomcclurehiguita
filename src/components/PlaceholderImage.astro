---
interface Props {
  label: string;
  tone?: "light" | "dark";
  class?: string;
}
const { label, tone = "light", class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex min-w-0 items-center justify-center overflow-hidden border border-dashed p-6 text-center text-[0.65rem] uppercase tracking-widest",
    tone === "dark"
      ? "border-old-lace/25 bg-old-lace/5 text-old-lace/50"
      : "border-coyote/40 bg-bone text-coyote",
    className,
  ]}
>
  <span class="wrap-break-words">{label}</span>
</div>